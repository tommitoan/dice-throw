{
  "name": "dice-throw",
  "version": "0.1.0",
  "description": "A dice throw with its own physics (the faces are decided first, the throw lands on them) and a hold-to-charge throw button.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./engine": "./src/dice-throw.js"
  },
  "files": [
    "src",
    "!src/**/*.test.*"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build:demo": "vite build",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^14.3.1",
    "@vitejs/plugin-react": "^4.2.1",
    "jsdom": "^24.1.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "vite": "^5.0.8",
    "vitest": "^1.1.0"
  }
}
